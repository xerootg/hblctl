{
  "type": "object",
  "properties": {
    "format": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "preconditions": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "firmware": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "profile_reviewed": {
          "const": true
        },
        "inventory_pending": {
          "const": false
        },
        "stock_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/(system|vendor|blackbox|tmp|data)/[^\\u0000]*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "reject_symlinks": {
          "const": true
        },
        "system_mount": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "models",
        "firmware",
        "profile_reviewed",
        "inventory_pending",
        "stock_hashes",
        "reject_symlinks",
        "system_mount"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "ready",
              "blocked"
            ]
          }
        },
        "required": [
          "id",
          "requires",
          "conflicts",
          "files",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "upstream": {
            "enum": [
              "gothenburg",
              "dash8097"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^/(system|vendor|blackbox|tmp|data)/[^\\u0000]*$"
          },
          "before": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "const": "ABSENT"
              }
            ]
          },
          "mode": {
            "enum": [
              "0644",
              "0755"
            ]
          },
          "kind": {
            "enum": [
              "source",
              "compile",
              "stock-recipe",
              "unresolved"
            ]
          },
          "status": {
            "enum": [
              "ready",
              "blocked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recipe": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string",
            "pattern": "^artifacts/[a-zA-Z0-9_./-]+$"
          },
          "build": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "toolchain",
              "target",
              "flags",
              "inputs"
            ],
            "properties": {
              "toolchain": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "const": "aarch64-linux-gnu"
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "origin"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "origin": {
                      "enum": [
                        "project",
                        "camera-stock"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "id",
          "upstream",
          "target",
          "before",
          "mode",
          "kind",
          "status",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              }
            },
            "then": {
              "required": [
                "output_sha256"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "source",
                    "compile",
                    "stock-recipe"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                },
                "kind": {
                  "const": "stock-recipe"
                }
              }
            },
            "then": {
              "required": [
                "recipe"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                },
                "kind": {
                  "const": "compile"
                }
              }
            },
            "then": {
              "required": [
                "build",
                "artifact"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                },
                "kind": {
                  "const": "source"
                }
              }
            },
            "then": {
              "required": [
                "artifact"
              ]
            }
          }
        ]
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "pattern": "^/(system|vendor|blackbox|tmp|data)/[^\\u0000]*$"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "algorithm": {
            "const": "byte-edits-v1"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "before_hex": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{2})*$"
                },
                "after_hex": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{2})*$"
                }
              },
              "required": [
                "offset",
                "before_hex",
                "after_hex"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "input",
          "input_sha256",
          "output_sha256",
          "algorithm",
          "edits"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "install",
              "restore"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "operation": {
            "enum": [
              "validate-profile",
              "verify-stock",
              "prepare-recipes",
              "backup",
              "stage-and-verify",
              "journal-prepared",
              "remount-rw",
              "write-files",
              "write-init",
              "sync-remount-ro",
              "journal-installed",
              "reboot",
              "verify-running",
              "verify-ownership",
              "withdraw-runtime",
              "verify-idle",
              "journal-restoring",
              "stop-services",
              "restore-backups",
              "remove-owned",
              "clear-journal"
            ]
          },
          "safety": {
            "enum": [
              "read",
              "volatile",
              "persistent",
              "destructive"
            ]
          },
          "transport_floor": {
            "enum": [
              "read",
              "volatile",
              "persistent",
              "destructive"
            ]
          },
          "on_failure": {
            "const": "retain-journal-and-stop"
          }
        },
        "required": [
          "id",
          "phase",
          "order",
          "operation",
          "safety",
          "transport_floor",
          "on_failure"
        ],
        "additionalProperties": false
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^/(system|vendor|blackbox|tmp|data)/[^\\u0000]*$"
        },
        "original_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "journal": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "restore_policy": {
          "const": "exact-owned-bytes-or-verified-interrupted-prefix"
        }
      },
      "required": [
        "root",
        "original_files",
        "journal",
        "phases",
        "restore_policy"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "install": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "restore": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "install",
        "restore"
      ],
      "additionalProperties": false
    },
    "reboot": {
      "type": "object",
      "properties": {
        "install": {
          "const": "required-after-commit"
        },
        "restore": {
          "const": "required-after-commit"
        },
        "upgrade": {
          "const": "restore-and-verify-before-install"
        }
      },
      "required": [
        "install",
        "restore",
        "upgrade"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "status",
    "reason",
    "license",
    "preconditions",
    "features",
    "files",
    "recipes",
    "steps",
    "backup",
    "verification",
    "reboot"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:x2d-toolkit:bundle:1",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "items": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              }
            }
          },
          "features": {
            "items": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              }
            }
          }
        }
      }
    }
  ]
}
